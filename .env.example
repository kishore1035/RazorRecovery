# Database
DATABASE_URL="file:./dev.db"

# Authentication
JWT_SECRET="generate_a_secure_random_string_here"

# Razorpay API Credentials (Required - Kindly use your own Razorpay keys)
# Obtain these from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
# Configured under Razorpay Dashboard -> Webhooks -> Add New Webhook
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# AI Provider (Groq / Ollama / OpenAI)
AI_PROVIDER_API_KEY="your_ai_provider_api_key_here"
OLLAMA_BASE_URL="http://localhost:11434"

# Push Notifications via ntfy.sh (Optional, free mobile push alerts)
# 1. Install ntfy app on iOS / Android or visit https://ntfy.sh
# 2. Subscribe to your unique topic name
NTFY_TOPIC="razorrecovery-merchant-demo"
NTFY_BASE_URL="https://ntfy.sh"

# SMS Customer Recovery Notifications (Optional)
# Options: "twilio" or "http" (Leave blank or unconfigured to use the built-in Console Simulator)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# App Public URL (For Webhooks and SMS deep-links in production or ngrok/cloudflared)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
